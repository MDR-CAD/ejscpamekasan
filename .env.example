# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN di-commit.

# Dari file JSON service account (field "client_email")
GOOGLE_CLIENT_EMAIL=nama-akun@id-project.iam.gserviceaccount.com

# Dari file JSON service account (field "private_key"). Tulis dalam satu baris,
# dengan tanda kutip dan \n apa adanya.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KUNCI\n-----END PRIVATE KEY-----\n"

# ID spreadsheet: bagian di antara /d/ dan /edit pada URL Google Sheets
SPREADSHEET_ID=

# String acak minimal 32 karakter. Buat dengan:  openssl rand -base64 32
AUTH_SECRET=

# Nama organisasi yang tampil di aplikasi (opsional)
ORG_NAME=Organisasi Kampus
